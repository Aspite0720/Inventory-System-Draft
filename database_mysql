CREATE DATABASE sari_sari_store;

USE sari_sari_store;

CREATE TABLE products (
    id          INT AUTO_INCREMENT PRIMARY KEY,
    name        VARCHAR(100)   NOT NULL,
    category    VARCHAR(50),
    quantity    INT            NOT NULL DEFAULT 0,
    price       DECIMAL(10,2) NOT NULL,
    supplier    VARCHAR(100)
);

ALTER TABLE products 
ADD COLUMN date_added    DATETIME DEFAULT CURRENT_TIMESTAMP,
ADD COLUMN date_updated  DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP;


 ALTER TABLE products ADD COLUMN low_stock_alert INT DEFAULT 5;

CREATE TABLE sales (
    saleID     INT AUTO_INCREMENT PRIMARY KEY,
    date_sold  DATETIME DEFAULT CURRENT_TIMESTAMP,
    productID  INT, productName VARCHAR(100), category VARCHAR(50),
    qty_sold   INT, unit_price DECIMAL(10,2), subtotal DECIMAL(10,2),
    FOREIGN KEY (productID) REFERENCES products(productID)
    );
